# Copy this file to `apps/web/.env.local` for local dev.
# Production: set the same variables on your host (e.g. Netlify → Site configuration → Environment variables).
# Names only below — never commit real secrets. See docs/DEPLOY.md for go/no-go checklist.

# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: required for /api/storage/logo, /api/storage/receipt, cron, and auto-confirming
# sign-ups (Auth confirmation emails are not sent unless you configure SMTP).
# Never expose this in the browser or client bundles.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#
# Optional: Authentication → Providers → Email → Confirm email = OFF
# if you do not want confirmation at all.

# App URL — no trailing slash. Required in production for share/pay/invite/webhook URLs.
# Must appear in Supabase → Authentication → URL Configuration → Redirect URLs, e.g.:
#   https://YOUR_SITE.netlify.app/reset-password
#   https://YOUR_SITE.netlify.app/dashboard
# Local dev may use http://localhost:3000; production builds throw if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo / sample login — SAFE DEFAULT FOR PROD
# Production: leave unset or set to 0 (demo login disabled).
# Local/dev: unset defaults to enabled when NODE_ENV !== production.
# Only set to 1 on a non-prod preview if you intentionally want sample mode.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=0

# --- Email (Resend) — required on the server to send invoice / invite / reminder emails ---
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Verified domain in Resend; default below may only work in dev if Resend allows it
# RESEND_FROM_EMAIL=TimelyInvoices <billing@your-verified-domain.com>

# --- WhatsApp (Twilio) — required on the server to send WhatsApp from the app ---
# https://console.twilio.com/ (WhatsApp sandbox or approved sender)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# E.164 without whatsapp: prefix, e.g. +14155238886 (sandbox) or your approved WhatsApp number
TWILIO_WHATSAPP_FROM=+1xxxxxxxxxx

# --- Cron (recurring invoices + collections) ---
# Required for /api/cron/recurring and /api/cron/collections.
# Call with: Authorization: Bearer <CRON_SECRET>  (prefer Bearer over ?secret=)
# Netlify + @netlify/plugin-nextjs: use an external scheduler (see docs/DEPLOY.md).
CRON_SECRET=long_random_string

# --- PayFast (invoice payments + SaaS checkout) ---
# Checkout/pay routes fail closed when merchant id/key are missing.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=1

# --- SnapScan (QR payments) ---
# Used by /api/payments/create-session (provider=snapscan) and webhook.
# SNAPSCAN_SNAPCODE=your_merchant_snapcode
# SNAPSCAN_WEBHOOK_AUTH_KEY=your_webhook_auth_key

# --- AI — optional. Invoice Generate works without a key (local parser).
# Groq (free tier) is preferred when set; otherwise Claude. Also used by Ask Timely.
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Observability ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Playwright E2E (optional) ---
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_QUOTE_SHARE_ID=

# --- Timely crew admin + platform Pay-by-EFT (SaaS billing) ---
# Crew console at /crew — only emails listed here (comma-separated, case-insensitive).
# Example (replace/extend for production crew):
TIMELY_CREW_EMAILS=john@icreativate.co.za
#
# Platform EFT bank details for Settings → Billing → Pay by EFT.
# Set real values in Netlify / .env.local only — never commit secrets.
# TIMELY_EFT_BANK_NAME=
# TIMELY_EFT_ACCOUNT_NAME=
# TIMELY_EFT_ACCOUNT_NUMBER=
# TIMELY_EFT_BRANCH_CODE=
# TIMELY_EFT_ACCOUNT_TYPE=
# UI shows: "Account name: {TIMELY_EFT_ACCOUNT_NAME} · Trading as Timely Invoices"

